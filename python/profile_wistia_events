
import json
from collections import Counter
from datetime import datetime

import boto3

BUCKET = "wistia-video-analytics-dev"
PREFIX = (
    "bronze/viewing_events/"
    "start_date=2026-04-08/"
    "end_date=2026-04-14/"
)

session = boto3.Session(
    profile_name="wistia-dev",
    region_name="us-east-1"
)
s3 = session.client("s3")

events = []
paginator = s3.get_paginator("list_objects_v2")

for page in paginator.paginate(Bucket=BUCKET, Prefix=PREFIX):
    for obj in page.get("Contents", []):
        if not obj["Key"].endswith(".json"):
            continue

        response = s3.get_object(
            Bucket=BUCKET,
            Key=obj["Key"]
        )
        document = json.loads(response["Body"].read())
        events.extend(document["data"])

keys = [e.get("event_key") for e in events]
valid_keys = [k for k in keys if k]

percentages = [
    float(e["percent_viewed"])
    for e in events
    if e.get("percent_viewed") is not None
]

media_counts = Counter(
    e.get("media_id") for e in events
)

visitor_keys = {
    e.get("visitor_key")
    for e in events
    if e.get("visitor_key")
}

invalid_timestamps = 0
for event in events:
    try:
        value = event.get("received_at")
        if not value:
            raise ValueError("Missing timestamp")
        datetime.fromisoformat(value.replace("Z", "+00:00"))
    except (ValueError, TypeError):
        invalid_timestamps += 1

print("\nWISTIA VIEWING EVENTS — DATA QUALITY PROFILE")
print("-" * 55)
print("Total records:", len(events))
print("Distinct event keys:", len(set(valid_keys)))
print("Missing event keys:", len(keys) - len(valid_keys))
print("Duplicate event keys:", len(valid_keys) - len(set(valid_keys)))
print("Distinct visitors:", len(visitor_keys))
print("Invalid timestamps:", invalid_timestamps)
print("Media counts:", dict(media_counts))

if percentages:
    print("Minimum percent_viewed:", min(percentages))
    print("Maximum percent_viewed:", max(percentages))
    print(
        "Average percent_viewed:",
        round(sum(percentages) / len(percentages), 4)
    )
